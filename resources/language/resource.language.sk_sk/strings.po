msgstr "Novo pridané s CZ dabingom"

msgctxt "#30398"
msgid "Popular on TMDB"
msgstr "Populárne na TMDB"

msgctxt "#30399"
msgid "Top rated"
msgstr "Najlepšie hodnotené"

msgctxt "#30401"
msgid "New with Czech subtitles"
msgstr "Novo pridané s CZ titulkami"

