msgctxt "#30164"
msgid "Sends a random installation id, add-on version, platform, last use and per-title stream view counts. Nothing else leaves the device. When switched off, only the random installation id and add-on version are still sent, so it is known the installation is alive."
msgstr "Posiela sa náhodné id inštalácie, verzia doplnku, platforma, posledné použitie a počty zobrazení streamov jednotlivých titulov. Nič ďalšie zariadenie neopúšťa. Po vypnutí sa ďalej posiela len náhodné id inštalácie a verzia doplnku, aby bolo vidieť, že inštalácia žije."

msgctxt "#30165"
msgid "Statistics sent"
msgstr "Štatistiky odoslané"

msgctxt "#30166"
msgid "Statistics could not be sent"
msgstr "Štatistiky sa nepodarilo odoslať"

