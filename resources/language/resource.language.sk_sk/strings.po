msgstr "Prihlásenie sa nepodarilo — skontroluj meno a heslo."

msgctxt "#30625"
msgid "Subtitles found for the test title: %s"
msgstr "Titulkov ku skúšobnému titulu: %s"

msgctxt "#30626"
msgid "Downloads left today: %s"
msgstr "Zostáva dnes stiahnutí: %s"

msgctxt "#30627"
msgid "Signed in as %s"
msgstr "Prihlásený ako %s"

msgctxt "#30628"
