msgid "Today"
msgstr "Dnes"

msgctxt "#30490"
msgid "Tomorrow"
msgstr "Zítra"

msgctxt "#30491"
msgid "Mon,Tue,Wed,Thu,Fri,Sat,Sun"
msgstr "po,út,st,čt,pá,so,ne"

msgctxt "#30492"
msgid "TV guide is not available right now"
msgstr "TV program teď není dostupný"

msgctxt "#30493"
msgid "No similar titles found"
msgstr "Žádné podobné tituly"

msgctxt "#30494"
msgid "No programmes in this selection"
msgstr "V tomto výběru nejsou žádné pořady"

msgctxt "#30495"
msgid "What to show for a stream and in which order"
msgstr "Co a v jakém pořadí ukazovat u streamu"

msgctxt "#30496"
msgid "Items separated by commas, the vertical bar splits the top and bottom line of the stream dialog. Whatever is missing is not shown. Items: langs (audio languages), size, video (resolution and codec), audio (audio tracks), bitrate, length, subs (subtitles), source, file (file name). Quality is always the picture on the left. Easier with Set up from phone."
msgstr "Položky oddělené čárkou, svislítko dělí horní a dolní řádek dialogu výběru streamu. Co chybí, se nezobrazí. Položky: langs (jazyky zvuku), size (velikost), video (rozlišení a kodek), audio (zvukové stopy), bitrate (datový tok), length (délka), subs (titulky), source (zdroj), file (název souboru). Kvalita je vždy obrázek vlevo. Pohodlněji přes Nastavit z mobilu."

msgctxt "#30497"
msgid "Default order"
msgstr "Výchozí pořadí"

msgctxt "#30498"
msgid "Puts back the default items and order. Reopen settings to see the new value."
msgstr "Vrátí výchozí položky a pořadí. Nová hodnota se zobrazí po znovuotevření nastavení."

msgctxt "#30499"
msgid "Top line|Bottom line"
msgstr "Horní řádek|Dolní řádek"

msgctxt "#30500"
msgid "Do not show"
msgstr "Nezobrazovat"

msgctxt "#30501"
msgid "Audio languages"
msgstr "Jazyky zvuku"

msgctxt "#30502"
msgid "Size"
msgstr "Velikost"

msgctxt "#30503"
msgid "Resolution and codec"
msgstr "Rozlišení a kodek"

msgctxt "#30504"
msgid "Audio tracks"
msgstr "Zvukové stopy"

msgctxt "#30505"
