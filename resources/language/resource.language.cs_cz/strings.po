msgstr "Titulků ke zkušebnímu titulu: %s"

msgctxt "#30626"
msgid "Downloads left today: %s"
msgstr "Zbývá dnes stažení: %s"

msgctxt "#30627"
msgid "Signed in as %s"
msgstr "Přihlášen jako %s"

msgctxt "#30628"
msgid "Not signed in — 5 downloads a day for this IP address."
msgstr "Bez přihlášení — 5 stažení denně pro tuto IP adresu."

msgctxt "#30630"
msgid "Source status"
msgstr "Stav zdrojů"

msgctxt "#30631"
msgid "subscription until %s"
msgstr "předplatné do %s"

msgctxt "#30632"
msgid "subscription ends in %s days"
msgstr "předplatné končí za %s dní"

