msgstr "Náhodný film"

msgctxt "#30609"
msgid "Random series"
msgstr "Náhodný seriál"

msgctxt "#30610"
msgid "Nothing to pick from"
msgstr "Není z čeho losovat"

msgctxt "#30611"
msgid "OpenSubtitles"
msgstr "OpenSubtitles"


msgctxt "#30613"
msgid "Look for subtitles on OpenSubtitles"
msgstr "Hledat titulky na OpenSubtitles"

msgctxt "#30614"
msgid "Used only for titles with no subtitles from the source, from WebShare or in the file itself."
msgstr "Použijí se jen u titulů, které nemají titulky ze zdroje, z WebShare ani přímo v souboru."

msgctxt "#30615"
msgid "OpenSubtitles account (optional)"
msgstr "Účet na OpenSubtitles (nepovinný)"

msgctxt "#30616"
msgid "Without an account you can download 5 subtitles a day, with a free account 20."
msgstr "Bez účtu se dá stáhnout 5 titulků denně, se zdarma založeným účtem 20."

msgctxt "#30617"
msgid "OpenSubtitles password"
msgstr "Heslo na OpenSubtitles"

msgctxt "#30618"
msgid "Sent only when signing in; only the issued token is stored."
msgstr "Posílá se jen při přihlášení, ukládá se z něj jen vydaný token."

msgctxt "#30619"
msgid "Test OpenSubtitles"
msgstr "Vyzkoušet OpenSubtitles"

msgctxt "#30620"
msgid "Checks the connection, the account and the remaining daily quota."
msgstr "Ověří spojení, účet i to, kolik titulků dnes ještě zbývá."

msgctxt "#30621"
msgid "OpenSubtitles works."
msgstr "OpenSubtitles funguje."

msgctxt "#30622"
msgid "OpenSubtitles is switched off in the settings."
msgstr "OpenSubtitles jsou v nastavení vypnuté."

msgctxt "#30623"
msgid "The key could not be fetched from the server — try again later."
msgstr "Klíč se nepodařilo získat ze serveru — zkus to později."

msgctxt "#30624"
msgid "Sign-in failed — check the username and password."
msgstr "Přihlášení se nepovedlo — zkontroluj jméno a heslo."

msgctxt "#30625"
