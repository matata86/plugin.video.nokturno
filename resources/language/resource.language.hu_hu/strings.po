msgstr "Luna beállítás ellenőrzése"

msgctxt "#30540"
msgid "Goes through your home network and fills in the address where Luna is running. It only takes a few seconds."
msgstr "Végigmegy az otthoni hálózatodon, és kitölti a címet, ahol a Luna fut. Csak pár másodpercig tart."

msgctxt "#30541"
msgid "Says exactly what is wrong: whether the server answers, whether the token is valid and whether any streams come back."
msgstr "Pontosan megmondja, mi a baj: válaszol-e a szerver, érvényes-e a token, és jönnek-e vissza streamek."

msgctxt "#30542"
msgid "Paste the add-on address from %s/setup"
msgstr "Illeszd be a bővítmény címét a(z) %s/setup oldalról"

msgctxt "#30543"
msgid "address and token are both missing"
msgstr "a cím és a token is hiányzik"

msgctxt "#30544"
msgid "the address makes no sense"
msgstr "a cím értelmezhetetlen"

msgctxt "#30545"
msgid "the server does not answer"
msgstr "a szerver nem válaszol"

msgctxt "#30546"
msgid "Luna is not running at that address"
msgstr "Azon a címen nem fut Luna"

msgctxt "#30547"
msgid "running, but the token is missing"
msgstr "fut, de hiányzik a token"

msgctxt "#30548"
msgid "what is in the Token field is not a token"
msgstr "ami a Token mezőben van, az nem token"

msgctxt "#30549"
msgid "Luna did not accept the token"
msgstr "A Luna nem fogadta el a tokent"

msgctxt "#30550"
msgid "the main source returns nothing – WebShare account in Luna?"
msgstr "a fő forrás semmit nem ad vissza – van WebShare fiók a Lunában?"

msgctxt "#30551"
msgid "no streams found – WebShare account in Luna?"
msgstr "nem találhatók streamek – van WebShare fiók a Lunában?"

msgctxt "#30552"
msgid "All good"
msgstr "Minden rendben"

msgctxt "#30553"
msgid "Careful"
msgstr "Vigyázat"

