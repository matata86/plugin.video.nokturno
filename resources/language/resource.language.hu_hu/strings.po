msgstr "Kód a másik Kodiról"

msgctxt "#30595"
msgid "Transfer failed: %s"
msgstr "Az átvitel nem sikerült: %s"

msgctxt "#30596"
msgid "%s settings will be written, from %s.[CR]Already the same: %s · not used here: %s[CR][CR]Current settings will be overwritten. A copy stays in %s."
msgstr "%s beállítás íródik be innen: %s.[CR]Már egyezik: %s · itt nem használható: %s[CR][CR]A mostani beállítások felülíródnak. Másolat marad itt: %s."

msgctxt "#30597"
