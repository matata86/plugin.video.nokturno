msgstr "Eszköz leválasztása"

msgctxt "#30566"
msgid "Account status"
msgstr "Fiók állapota"

msgctxt "#30567"
msgid "On your phone or computer open[CR][B]%s[/B][CR]log in and enter PIN [B]%s[/B]"
msgstr "Telefonon vagy számítógépen nyisd meg:[CR][B]%s[/B][CR]jelentkezz be, és add meg a PIN-kódot: [B]%s[/B]"

msgctxt "#30568"
msgid "CZtor: %s, plan %s until %s"
msgstr "CZtor: %s, előfizetés: %s, lejár: %s"

msgctxt "#30569"
msgid "Pairing with CZtor failed."
msgstr "A CZtor párosítás nem sikerült."

msgctxt "#30570"
msgid "CZtor unpaired."
msgstr "CZtor leválasztva."

msgctxt "#30571"
msgid "CZtor is not paired — use Pair with PIN."
msgstr "A CZtor nincs párosítva — használd a Párosítás PIN-kóddal lehetőséget."

