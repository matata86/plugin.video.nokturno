msgid "Hungarian"
msgstr "Magyar"

msgctxt "#30560"
msgid "CZtor"
msgstr "CZtor"

msgctxt "#30561"
msgid "Enable CZtor"
msgstr "CZtor bekapcsolása"

msgctxt "#30562"
msgid "CZtor catalogue with a subscription (cztor.com, storage at giganthost.com). The device is paired with a PIN — the account password is never entered into the add-on."
msgstr "CZtor katalógus előfizetéssel (cztor.com, tárhely: giganthost.com). Az eszköz PIN-kóddal párosítható — a fiók jelszavát nem kell megadni a kiegészítőben."

msgctxt "#30563"
msgid "Pair with PIN"
msgstr "Párosítás PIN-kóddal"

msgctxt "#30564"
msgid "Open cztor.com/activate on your phone or computer, log in and enter the PIN shown here."
msgstr "Nyisd meg a cztor.com/activate oldalt telefonon vagy számítógépen, jelentkezz be, és add meg az itt megjelenő PIN-kódot."

msgctxt "#30565"
